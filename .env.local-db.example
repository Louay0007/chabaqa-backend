# Local MongoDB development overrides
MONGO_URI=mongodb://127.0.0.1:27017/chabaqa_local
DB_NAME=chabaqa_local
ALLOW_REMOTE_WIPE=false
SAMPLE_LIMIT=5

# mongo-express basic auth
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=chabaqa

# AI Tutor (OpenRouter)
AI_PROVIDER=OLLAMA_CLOUD
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_APP_NAME=Chabaqa AI Tutor
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Chabaqa AI Tutor
OPENROUTER_SITE_URL=http://localhost:8080
AI_MODEL=gpt-oss:20b-cloud
AI_FALLBACK_MODELS=minimax-m2.1:cloud,glm-4.7:cloud
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.3
AI_CONTEXT_CHAR_LIMIT=16000
